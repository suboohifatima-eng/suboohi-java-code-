public class insertion {

public static void main(String[] args) {


        int arr[] = { 2,5,3,4,6};
        Sort (arr);
        for(int i = 0;i<arr.length;i++){
            System.out.print(arr[i] + " ");

 }
      }
      public static void  Sort(int arr[] ){
        for(int i = 1; i< arr.length; i++ ){

            int picked = arr[i];
            int j = i - 1;
            while( j >= 0 && arr[j] > picked){

                arr[j+1] = arr[j];

                j--;
            }


              arr[j+1] = picked;

                
            }
        }
      }


    

